      {"name":"Enter Moniepoint actual balance","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"raw","raw":"{\"provider_id\":\"{{moniepoint_provider_id}}\",\"actual_balance\":\"44840.00\"}"},"url":"{{base_url}}/api/daily-closings/{{closing_id}}/balances"}},
      {"name":"Enter PalmPay actual balance","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"raw","raw":"{\"provider_id\":\"{{palmpay_provider_id}}\",\"actual_balance\":\"89690.00\"}"},"url":"{{base_url}}/api/daily-closings/{{closing_id}}/balances"}},
      {"name":"Finalize after all balances entered","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"url":"{{base_url}}/api/daily-closings/{{closing_id}}/finalize"},"event":[{"listen":"test","script":{"exec":["pm.test('closing finalized with backend values',()=>{const j=pm.response.json();pm.response.to.have.status(200);pm.expect(j.status).to.eql('finalized');pm.expect(j.total_variance).to.eql('-60.00');});"]}}]},
      {"name":"Closing detail","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/daily-closings/{{closing_id}}"},"event":[{"listen":"test","script":{"exec":["pm.test('daily closing arithmetic',()=>{const j=pm.response.json();pm.expect(j.expected_cash).to.eql('16700.00');pm.expect(j.expected_electronic_position).to.eql('184380.00');pm.expect(j.actual_electronic_position).to.eql('184330.00');pm.expect(j.total_variance).to.eql('-60.00');});"]}}]},
