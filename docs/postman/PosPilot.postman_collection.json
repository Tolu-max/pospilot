      {"name":"Save fictional local-only credential placeholders (never production credentials)","request":{"method":"PUT","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"raw","raw":"{\"api_key\":\"fictional-local-qa-key-not-a-secret\",\"webhook_secret\":\"fictional-local-qa-secret-not-live\",\"business_id\":\"123456789\"}"},"url":"{{base_url}}/api/providers/moniepoint/connection"},"event":[{"listen":"test","script":{"exec":["pm.test('connection response never echoes submitted values', () => {pm.expect(pm.response.code).to.be.oneOf([200,201,503]); pm.expect(pm.response.text()).not.to.include('fictional-local-qa-key-not-a-secret'); pm.expect(pm.response.text()).not.to.include('fictional-local-qa-secret-not-live');});"]}}]},
