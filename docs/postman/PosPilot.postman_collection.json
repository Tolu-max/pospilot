      {"name":"Malformed transaction CSV (422; select a malformed CSV)","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"formdata","formdata":[{"key":"provider_id","value":"{{opay_provider_id}}","type":"text"},{"key":"file","type":"file","src":[]}]},"url":"{{base_url}}/transactions/import/preview"},"event":[{"listen":"test","script":{"exec":["pm.test('malformed fixture should be rejected with 422', () => pm.response.to.have.status(422));"]}}]}
