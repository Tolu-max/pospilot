{
  "info": {
    "_postman_id": "95b358e8-c197-49b1-a0cf-70bc0f9e8c5a",
    "name": "POSPilot Integration QA",
    "description": "QA collection for the real POSPilot Laravel web-session API. No bearer token is used. Retain the Laravel session cookie and send the CSRF meta token on writes. Use fictional CSV fixtures and never use real provider credentials.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{"key":"base_url","value":"http://127.0.0.1:8000"},{"key":"csrf_token","value":""},{"key":"test_name","value":"POSPilot QA Agent"},{"key":"test_email","value":""},{"key":"test_password","value":"Password123!"},{"key":"other_email","value":""},{"key":"other_password","value":"Password123!"},{"key":"opay_provider_id","value":""},{"key":"moniepoint_provider_id","value":""},{"key":"palmpay_provider_id","value":""},{"key":"other_provider_id","value":""},{"key":"opay_terminal_id","value":""},{"key":"moniepoint_terminal_id","value":""},{"key":"palmpay_terminal_id","value":""},{"key":"opay_transaction_id","value":""},{"key":"pending_transaction_id","value":""},{"key":"closing_id","value":""},{"key":"transaction_preview_token","value":""},{"key":"settlement_preview_token","value":""}],
  "item": [
    {"name":"Authentication","item":[
      {"name":"Unauthenticated financial summary (401)","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/financial-summary"},"event":[{"listen":"test","script":{"exec":["pm.test('session required', () => pm.response.to.have.status(401));"]}}]},
      {"name":"Get login page and CSRF meta token","request":{"method":"GET","header":[{"key":"Accept","value":"text/html"}],"url":"{{base_url}}/login"},"event":[{"listen":"test","script":{"exec":["pm.test('login page loads', () => pm.expect(pm.response.code).to.be.oneOf([200, 302]));","const match = pm.response.text().match(/name=\"csrf-token\" content=\"([^\"]+)\"/);","pm.test('CSRF token meta exists', () => pm.expect(match).to.not.equal(null));","if (match) pm.environment.set('csrf_token', match[1]);"]}}]},
      {"name":"Register QA user (first run)","request":{"method":"POST","header":[{"key":"Accept","value":"text/html"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"},{"key":"Content-Type","value":"application/x-www-form-urlencoded"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"name","value":"{{test_name}}"},{"key":"email","value":"{{test_email}}"},{"key":"password","value":"{{test_password}}"},{"key":"password_confirmation","value":"{{test_password}}"}]},"url":"{{base_url}}/register"},"event":[{"listen":"prerequest","script":{"exec":["pm.environment.set('test_email','qa-'+Date.now()+'@example.test');"]}},{"listen":"test","script":{"exec":["pm.test('registration completed or redirected', () => pm.expect(pm.response.code).to.be.oneOf([200, 201, 302, 303]));"]}}]},
      {"name":"Logout (session invalidation)","request":{"method":"POST","header":[{"key":"Accept","value":"text/html"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"url":"{{base_url}}/logout"},"event":[{"listen":"test","script":{"exec":["pm.test('logout redirects', () => pm.expect(pm.response.code).to.be.oneOf([200, 302, 303]));"]}}]},
      {"name":"Refresh login page CSRF token","request":{"method":"GET","header":[{"key":"Accept","value":"text/html"}],"url":"{{base_url}}/login"},"event":[{"listen":"test","script":{"exec":["const match = pm.response.text().match(/name=\"csrf-token\" content=\"([^\"]+)\"/);","pm.test('CSRF token refreshed', () => pm.expect(match).to.not.equal(null));","if (match) pm.environment.set('csrf_token', match[1]);"]}}]},
      {"name":"Invalid password (422)","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"email","value":"{{test_email}}"},{"key":"password","value":"wrong-password"}]},"url":"{{base_url}}/login"},"event":[{"listen":"test","script":{"exec":["pm.test('invalid credentials rejected', () => pm.response.to.have.status(422));"]}}]},
      {"name":"Login (session cookie; no Bearer token)","request":{"method":"POST","header":[{"key":"Accept","value":"text/html"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"},{"key":"Content-Type","value":"application/x-www-form-urlencoded"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"email","value":"{{test_email}}"},{"key":"password","value":"{{test_password}}"}]},"url":"{{base_url}}/login"},"event":[{"listen":"test","script":{"exec":["pm.test('login accepted', () => pm.expect(pm.response.code).to.be.oneOf([200, 302, 303]));"]}}]}
    ]},
    {"name":"Agent Profile","item":[
      {"name":"Read profile","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/agent/profile"},"event":[{"listen":"test","script":{"exec":["pm.test('profile response', () => pm.response.to.have.status(200));","pm.test('currency present', () => pm.expect(pm.response.json().currency).to.eql('NGN'));"]}}]},
      {"name":"Update profile and onboarding","request":{"method":"PATCH","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"raw","raw":"{\"business_name\":\"QA Fictional POS\",\"country\":\"Nigeria\",\"currency\":\"NGN\",\"onboarding_state\":\"completed\"}"},"url":"{{base_url}}/api/agent/profile"},"event":[{"listen":"test","script":{"exec":["pm.test('profile updated', () => pm.response.to.have.status(200));","pm.test('onboarding complete', () => pm.expect(pm.response.json().onboarding_state).to.eql('completed'));"]}}]}
    ]},
    {"name":"Providers","item":[
      {"name":"List providers and capture IDs","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/providers"},"event":[{"listen":"test","script":{"exec":["pm.test('provider list', () => pm.response.to.have.status(200));","const rows = pm.response.json().data || [];","for (const p of rows) { if (p.slug==='opay') pm.collectionVariables.set('opay_provider_id', p.id); if (p.slug==='moniepoint') pm.collectionVariables.set('moniepoint_provider_id', p.id); if (p.slug==='palmpay') pm.collectionVariables.set('palmpay_provider_id', p.id); if (p.slug==='other') pm.collectionVariables.set('other_provider_id', p.id); }","pm.test('three primary providers available', () => ['opay','moniepoint','palmpay'].forEach(s => pm.expect(rows.some(p => p.slug===s)).to.eql(true)));"]}}]}
    ]},
    {"name":"Provider Connections","item":[{"name":"List safe connection state","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/provider-connections"},"event":[{"listen":"test","script":{"exec":["pm.test('connections available', () => pm.response.to.have.status(200));","pm.test('no credential-like response keys', () => pm.expect(pm.response.text()).not.to.match(/api_key|webhook_secret|private_key|clientAuthKey/i));"]}}]}]},
    {"name":"Terminals","item":[
      {"name":"List terminals","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/terminals"},"event":[{"listen":"test","script":{"exec":["pm.test('terminal list', () => pm.response.to.have.status(200));"]}}]},
      {"name":"Create fictional OPay terminal","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"raw","raw":"{\"provider_id\":\"{{opay_provider_id}}\",\"name\":\"QA OPay Terminal\",\"terminal_identifier\":\"OPA-QA-01\",\"active\":true}"},"url":"{{base_url}}/api/terminals"},"event":[{"listen":"test","script":{"exec":["pm.test('terminal created', () => pm.response.to.have.status(201));","pm.collectionVariables.set('opay_terminal_id', pm.response.json().id);"]}}]},
      {"name":"Create fictional Moniepoint terminal","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"raw","raw":"{\"provider_id\":\"{{moniepoint_provider_id}}\",\"name\":\"QA Moniepoint Terminal\",\"terminal_identifier\":\"MP-QA-01\",\"active\":true}"},"url":"{{base_url}}/api/terminals"},"event":[{"listen":"test","script":{"exec":["pm.test('terminal created', () => pm.response.to.have.status(201));","pm.collectionVariables.set('moniepoint_terminal_id', pm.response.json().id);"]}}]},
      {"name":"Create fictional PalmPay terminal","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"raw","raw":"{\"provider_id\":\"{{palmpay_provider_id}}\",\"name\":\"QA PalmPay Terminal\",\"terminal_identifier\":\"PPA-QA-01\",\"active\":true}"},"url":"{{base_url}}/api/terminals"},"event":[{"listen":"test","script":{"exec":["pm.test('terminal created', () => pm.response.to.have.status(201));","pm.collectionVariables.set('palmpay_terminal_id', pm.response.json().id);"]}}]},
      {"name":"Optional: create Generic/Other terminal","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"raw","raw":"{\"provider_id\":\"{{other_provider_id}}\",\"name\":\"QA Generic Terminal\",\"terminal_identifier\":\"GENERIC-TERM-01\",\"active\":true}"},"url":"{{base_url}}/api/terminals"}},
      {"name":"Invalid terminal ID (404)","request":{"method":"PATCH","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"raw","raw":"{\"name\":\"invalid id test\"}"},"url":"{{base_url}}/api/terminals/999999999"},"event":[{"listen":"test","script":{"exec":["pm.test('unknown terminal hidden', () => pm.response.to.have.status(404));"]}}]}
    ]},
    {"name":"Charge Rules","item":[
      {"name":"List charge rules","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/charge-rules"}},
      {"name":"Create first scenario band","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"raw","raw":"{\"minimum_amount\":\"1.00\",\"maximum_amount\":\"40000.00\",\"charge_type\":\"fixed\",\"charge_value\":\"500.00\",\"priority\":1,\"active\":true}"},"url":"{{base_url}}/api/charge-rules"},"event":[{"listen":"test","script":{"exec":["pm.test('rule created', () => pm.response.to.have.status(201));"]}}]},
      {"name":"Create middle scenario band","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"raw","raw":"{\"minimum_amount\":\"40000.01\",\"maximum_amount\":\"49999.99\",\"charge_type\":\"fixed\",\"charge_value\":\"600.00\",\"priority\":1,\"active\":true}"},"url":"{{base_url}}/api/charge-rules"}},
      {"name":"Create top scenario band","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"raw","raw":"{\"minimum_amount\":\"50000.00\",\"maximum_amount\":null,\"charge_type\":\"fixed\",\"charge_value\":\"700.00\",\"priority\":1,\"active\":true}"},"url":"{{base_url}}/api/charge-rules"}},
      {"name":"Preview 50k rule charge","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/charge-rules/preview?amount=50000.00"},"event":[{"listen":"test","script":{"exec":["pm.test('preview returns expected value after all three rules are configured', () => pm.expect(pm.response.json().charge).to.eql('700.00'));"]}}]},
      {"name":"Reject reversed charge range (422)","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"raw","raw":"{\"minimum_amount\":\"100.00\",\"maximum_amount\":\"50.00\",\"charge_type\":\"fixed\",\"charge_value\":\"5.00\",\"priority\":1,\"active\":true}"},"url":"{{base_url}}/api/charge-rules"},"event":[{"listen":"test","script":{"exec":["pm.test('invalid amount range rejected', () => pm.response.to.have.status(422));"]}}]},
      {"name":"Reject negative preview amount (422)","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/charge-rules/preview?amount=-1"},"event":[{"listen":"test","script":{"exec":["pm.test('negative amount rejected', () => pm.response.to.have.status(422));"]}}]}
    ]},
    {"name":"Transactions","item":[
      {"name":"List/filter by reference and date","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/transactions?reference=QA-OP-001&from=2026-06-01&to=2026-06-01&per_page=100"},"event":[{"listen":"test","script":{"exec":["pm.test('filtered transactions', () => pm.response.to.have.status(200));","const row=(pm.response.json().data||[])[0]; if(row) pm.collectionVariables.set('opay_transaction_id', row.id);"]}}]},
      {"name":"Find pending row for override","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/transactions?reference=QA-OP-002&per_page=10"},"event":[{"listen":"test","script":{"exec":["const row=(pm.response.json().data||[])[0]; pm.test('pending row exists',()=>pm.expect(row).to.exist); if(row) pm.collectionVariables.set('pending_transaction_id',row.id);"]}}]},
      {"name":"Override pending row charge (does not affect earnings)","request":{"method":"PATCH","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"raw","raw":"{\"customer_charge_override\":\"550.00\"}"},"url":"{{base_url}}/api/transactions/{{pending_transaction_id}}/customer-charge"},"event":[{"listen":"test","script":{"exec":["pm.test('override recorded',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().customer_charge_source).to.eql('manual');});"]}}]},
      {"name":"Transaction detail","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/transactions/{{opay_transaction_id}}"}},
      {"name":"Reject negative customer-charge override (422)","request":{"method":"PATCH","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"raw","raw":"{\"customer_charge_override\":\"-5.00\"}"},"url":"{{base_url}}/api/transactions/{{opay_transaction_id}}/customer-charge"},"event":[{"listen":"test","script":{"exec":["pm.test('negative override rejected', () => pm.response.to.have.status(422));"]}}]}
