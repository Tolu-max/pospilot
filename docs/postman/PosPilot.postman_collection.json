      {"name":"Save draft (opening cash and actual cash)","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"raw","raw":"{\"closing_date\":\"2026-06-01\",\"opening_cash\":\"200000.00\",\"entered_closing_cash\":\"16690.00\"}"},"url":"{{base_url}}/api/daily-closings"},"event":[{"listen":"test","script":{"exec":["pm.test('draft saved', () => pm.response.to.have.status(201));","pm.collectionVariables.set('closing_id',pm.response.json().id);"]}}]},
