    {"name":"Transaction Imports","item":[
      {"name":"Preview OPay scenario CSV (select docs/qa/scenario/opay-transactions.csv)","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"formdata","formdata":[{"key":"provider_id","value":"{{opay_provider_id}}","type":"text"},{"key":"file","type":"file","src":[]}]},"url":"{{base_url}}/transactions/import/preview"},"event":[{"listen":"test","script":{"exec":["pm.test('preview has valid rows', () => {pm.response.to.have.status(200); pm.expect(pm.response.json().rows_detected).to.eql(2);});","pm.collectionVariables.set('transaction_preview_token', pm.response.json().preview_token);"]}}]},
      {"name":"Confirm transaction preview","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"raw","raw":"{\"preview_token\":\"{{transaction_preview_token}}\"}"},"url":"{{base_url}}/transactions/import/confirm"},"event":[{"listen":"test","script":{"exec":["pm.test('two rows imported', () => {pm.response.to.have.status(200); pm.expect(pm.response.json().rows_imported).to.eql(2);});"]}}]},
      {"name":"Preview duplicate OPay statement","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"formdata","formdata":[{"key":"provider_id","value":"{{opay_provider_id}}","type":"text"},{"key":"file","type":"file","src":[]}]},"url":"{{base_url}}/transactions/import/preview"},"event":[{"listen":"test","script":{"exec":["pm.test('both identical rows detected as duplicates',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().duplicates).to.eql(2);});","pm.collectionVariables.set('transaction_preview_token',pm.response.json().preview_token);"]}}]},
      {"name":"Confirm duplicate OPay statement","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"raw","raw":"{\"preview_token\":\"{{transaction_preview_token}}\"}"},"url":"{{base_url}}/transactions/import/confirm"},"event":[{"listen":"test","script":{"exec":["pm.test('no duplicate rows persisted',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().rows_imported).to.eql(0);pm.expect(pm.response.json().rows_duplicate).to.eql(2);});"]}}]},
      {"name":"Preview Moniepoint transaction CSV (select docs/qa/scenario/moniepoint-transactions.csv)","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"formdata","formdata":[{"key":"provider_id","value":"{{moniepoint_provider_id}}","type":"text"},{"key":"file","type":"file","src":[]}]},"url":"{{base_url}}/transactions/import/preview"},"event":[{"listen":"test","script":{"exec":["pm.test('Moniepoint CSV preview valid',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().invalid).to.eql(0);});","pm.collectionVariables.set('transaction_preview_token',pm.response.json().preview_token);"]}}]},
      {"name":"Confirm Moniepoint transaction import","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"raw","raw":"{\"preview_token\":\"{{transaction_preview_token}}\"}"},"url":"{{base_url}}/transactions/import/confirm"}},
      {"name":"Preview PalmPay transaction CSV (select docs/qa/scenario/palmpay-transactions.csv)","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"formdata","formdata":[{"key":"provider_id","value":"{{palmpay_provider_id}}","type":"text"},{"key":"file","type":"file","src":[]}]},"url":"{{base_url}}/transactions/import/preview"},"event":[{"listen":"test","script":{"exec":["pm.test('PalmPay CSV preview valid',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().rows_detected).to.eql(3);});","pm.collectionVariables.set('transaction_preview_token',pm.response.json().preview_token);"]}}]},
      {"name":"Confirm PalmPay transaction import","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"raw","raw":"{\"preview_token\":\"{{transaction_preview_token}}\"}"},"url":"{{base_url}}/transactions/import/confirm"}},
      {"name":"Optional: preview Generic CSV (select docs/sample-imports/generic.csv; mapping fields included)","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"formdata","formdata":[{"key":"provider_id","value":"{{other_provider_id}}","type":"text"},{"key":"file","type":"file","src":[]},{"key":"mapping[external_reference]","value":"Reference","type":"text"},{"key":"mapping[amount]","value":"Transaction Amount","type":"text"},{"key":"mapping[provider_fee]","value":"Provider Fee","type":"text"},{"key":"mapping[transaction_status]","value":"Status","type":"text"},{"key":"mapping[transaction_at]","value":"Date/Time","type":"text"},{"key":"mapping[terminal_identifier]","value":"Terminal","type":"text"}]},"url":"{{base_url}}/transactions/import/preview"},"event":[{"listen":"test","script":{"exec":["pm.test('generic mapping preview',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().invalid).to.eql(0);});","pm.collectionVariables.set('transaction_preview_token',pm.response.json().preview_token);"]}}]},
      {"name":"Optional: confirm Generic CSV import","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"raw","raw":"{\"preview_token\":\"{{transaction_preview_token}}\"}"},"url":"{{base_url}}/transactions/import/confirm"}},
      {"name":"Import history","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/imports"}},
      {"name":"Invalid preview token (422)","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-CSRF-TOKEN","value":"{{csrf_token}}"}],"body":{"mode":"raw","raw":"{\"preview_token\":\"not-a-valid-session-preview-token\"}"},"url":"{{base_url}}/transactions/import/confirm"},"event":[{"listen":"test","script":{"exec":["pm.test('invalid token rejected', () => pm.response.to.have.status(422));"]}}]}
    ]},
