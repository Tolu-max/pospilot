    {"name":"Financial Summary","item":[{"name":"Scenario summary (2026-06-01)","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/financial-summary?from=2026-06-01&to=2026-06-01"},"event":[{"listen":"test","script":{"exec":["pm.test('scenario totals and confidence', () => {const j=pm.response.json(); pm.response.to.have.status(200); pm.expect(j.transaction_volume).to.eql('185000.00'); pm.expect(j.customer_charges_collected).to.eql('2500.00'); pm.expect(j.provider_fees).to.eql('620.00'); pm.expect(j.expenses).to.eql('800.00'); pm.expect(j.estimated_net_earnings).to.eql('1080.00'); pm.expect(j.earnings_status).to.eql('provisional');});"]}}]},{"name":"Provider breakdown","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/api/provider-breakdown?from=2026-06-01&to=2026-06-01"}}]},
