APP_NAME="POSPilot"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=posagent_bot
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# For production behind HTTPS, set SESSION_ENCRYPT=true, SESSION_SECURE_COOKIE=true,
# SESSION_HTTP_ONLY=true, and SESSION_SAME_SITE=lax.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Local development only; production must use a reviewed external secret manager adapter.
PROVIDER_SECRET_STORE=database
# PROVIDER_SECRET_STORE=external
# PROVIDER_SECRET_STORE_CLASS=

# Optional Google OAuth; blank configuration safely disables Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Gmail statement access uses a separate OAuth client and consent flow from Google sign-in.
FEATURE_GMAIL_STATEMENTS=true
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=https://pospilot.tconnect.com.ng/integrations/gmail/callback
# OAuth tokens use Laravel encryption backed by APP_KEY and are stored separately from connection metadata.
GMAIL_TOKEN_STORE=external
GMAIL_TOKEN_STORE_CLASS=
# Optional reviewed external credential store adapter:
# Local/test-only alternative; production refuses the database token store.
# GMAIL_TOKEN_STORE=database

# Direct provider flags only expose implemented paths; they do not mean live tested.
# OPay transaction-history client is not implemented; Moniepoint introspection does not sync existing POS activity.
FEATURE_MONIEPOINT_DIRECT=false
FEATURE_OPAY_DIRECT=false
FEATURE_PALMPAY_DIRECT=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# SendByte SMTP mailer. Live delivery requires a verified sender domain.
# Never commit a real key. Keep the app on MAIL_MAILER=log for local development unless intentionally testing delivery.
SENDBYTE_API_KEY=
SENDBYTE_SMTP_HOST=smtp.sendbyte.africa
SENDBYTE_SMTP_PORT=2525
SENDBYTE_SMTP_SCHEME=smtp
SENDBYTE_SMTP_USERNAME=apikey

# Cencori server-side AI gateway for aggregate-only dashboard business insights.
# Never prefix this secret with VITE_ or commit a real key.
FEATURE_CENCORI_BUSINESS_INSIGHT=false
CENCORI_API_KEY=
CENCORI_BASE_URL=https://api.cencori.com/v1
CENCORI_MODEL=gpt-4o
CENCORI_TIMEOUT=20

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
SENDBYTE_SMTP_TIMEOUT=15
